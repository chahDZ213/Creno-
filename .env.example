# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique, utilisée dans les liens des emails et SMS
NEXT_PUBLIC_URL_BASE=http://localhost:3000

# Emails — deux voies, la première l'emporte.
#
# 1. SMTP : l'expéditeur est une vraie boîte (Gmail, par exemple), donc les
#    messages arrivent partout sans posséder de nom de domaine. Le mot de
#    passe est un « mot de passe d'application », jamais celui du compte.
SMTP_UTILISATEUR=
SMTP_MOTDEPASSE=
SMTP_HOTE=smtp.gmail.com
SMTP_PORT=465
#
# 2. Resend : pour la suite, quand Créno aura son domaine.
RESEND_API_KEY=
#
# Laissé vide, l'expéditeur reprend l'adresse SMTP.
CRENO_EMAIL_EXPEDITEUR=

# SMS (Twilio). Sans clés, les messages sont écrits en console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMERO=

# Jeton partagé des tâches planifiées (rappels J-1, relance 12 h)
CRENO_CLE_CRON=

# Compte de démonstration créé par `npm run seed`
CRENO_DEMO_EMAIL=patron@garage-ducret.fr
CRENO_DEMO_MOTDEPASSE=creno-demo-2026
