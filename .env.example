# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique, utilisée dans les liens des emails et SMS
NEXT_PUBLIC_URL_BASE=http://localhost:3000

# Emails (Resend). Sans clé, les messages sont écrits en console.
RESEND_API_KEY=
CRENO_EMAIL_EXPEDITEUR="Créno <bonjour@creno.fr>"

# SMS (Twilio). Sans clés, les messages sont écrits en console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMERO=

# Jeton partagé des tâches planifiées (rappels J-1, relance 12 h)
CRENO_CLE_CRON=

# Compte de démonstration créé par `npm run seed`
CRENO_DEMO_EMAIL=patron@garage-ducret.fr
CRENO_DEMO_MOTDEPASSE=creno-demo-2026
